          "name": "走私客莉娜",
          "onWin": "pier_win",
          "onLose": "pier_press"
        }
      },
      "choices": [
        {
          "id": "resolve",
          "label": "确认交锋结果之后继续追击莉娜",
          "next": "foot_dock"
        }
      ]
    },
    "foot_dock": {
      "narrative": "莉娜沿着栈桥狂奔，积水溅起白沫。你们追上去——前方是系着绳的小艇，引擎盖已掀开，怠速在雨里发抖。缆绳在桩上磨出湿痕，螺旋桨尚未入水，却已经把黑水搅出一圈白沫。雾笛又响了一声，像在催她把跳板彻底甩掉。跳板在脚下发滑。",
      "checkpoint": "徒步追逐：栈桥拉近",
