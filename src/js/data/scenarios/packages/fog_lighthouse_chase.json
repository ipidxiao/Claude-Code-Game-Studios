    "fog_path": {
      "narrative": "雾把岬角小径剪成一段段白墙。守塔人卡尔踢翻油灯窜向悬崖方向——你们只能先在湿滑石阶上交锋，再决定是否追进那片吞没轮廓的雾堤。远处雾笛被风撕碎，像倒计时已经开始，而灯塔顶的旋转光只剩一道被雾吃掉的残弧。",
      "checkpoint": "岬角交锋：守塔人察觉盯梢",
      "effects": {
        "combat": {
          "creatureId": "cultist",
          "mode": "exchange",
          "pendingRoll": true,
          "attacker": "pc",
          "weaponId": "knife",
          "name": "守塔人卡尔",
          "onWin": "path_win",
          "onLose": "path_press"
        }
      },
      "choices": [
