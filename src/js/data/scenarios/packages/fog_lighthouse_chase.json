    "ending_win": {
      "narrative": "雾稍散时，卡尔被铐在灯室栏杆上，岸街警笛隐约传来。你们从岬角一路追上螺旋铁梯，湿岩与铁阶磨破了掌心，好在人没有跑掉。\n\n【结局：追上】守塔人落网。",
      "effects": {
        "journal": "雾锁灯塔：猎物落网。",
        "enchantmentId": "elder_sign",
        "sanCheck": "0/1"
      },
      "end": true
    },
    "ending_escape": {
      "narrative": "靴声消失在雾堤尽头。你们站在空荡窄径，只剩打翻的油灯与绳索印；至少摸清了对方上塔路线，下次不会再空手而归，雾笛也渐渐变成可记录的方位与节奏备查。\n\n【结局：逃脱】猎物跑了，但你们摸清了路线。",
      "effects": {
        "journal": "追逐失败；记下上塔路线。",
        "sanCheck": "0/1"
      },
      "end": true
    },
